{
  "name": "play198x.github.io",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "ui:fetch": "./scripts/fetch-ui.sh",
    "predev": "npm run ui:fetch",
    "dev": "astro dev",
    "prebuild": "npm run ui:fetch",
    "build": "astro build && node scripts/check-routes.mjs && node scripts/check-internal-links.mjs && node scripts/check-prose.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "prose": "node scripts/check-prose.mjs",
    "a11y": "node scripts/a11y-sweep.mjs",
    "preview": "astro preview",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:e2e": "node --test tests/player.spec.ts tests/worklet-crash.spec.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@play198x/web": "^0.1.3",
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
