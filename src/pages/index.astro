---
import BaseLayout from '../layouts/BaseLayout.astro';
import DropTarget from '../components/DropTarget.astro';
import Player from '../components/Player.astro';

const description = 'Play198x: a retro media player that runs entirely in your browser.';
---

<BaseLayout title="Play198x" description={description} canonical="https://play198x.github.io/">
  <!-- The hero is the player. This site does not describe a thing you could
       go and use; it is the thing, so the drop target sits in the hero rather
       than below a row of buttons pointing at it. There is no button row for
       the same reason the Downloads section below says what it says: there is
       no application to send anyone to yet, and a call to action leading to
       "not yet" is worse than none. -->
  <section class="hero band">
    <div class="container">
      <p class="eyebrow">A retro media player</p>
      <h1 class="hero-title">Play198x</h1>
      <p class="hero-lead">
        Play198x plays retro media in your browser. Drop a file below to play it — nothing you feed
        it ever leaves your browser.
      </p>

      <DropTarget />
      <Player />
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="columns">
        <section class="prose" aria-labelledby="what-it-is-heading">
          <h2 id="what-it-is-heading">What Play198x is</h2>
          <p>Play198x renders media. It does not boot a machine, run a program, or emulate a CPU.</p>
          <p>
            A ZX Spectrum SCREEN$ or a Commodore 64 bitmap opens the way a photo does; a ProTracker
            module plays the way an MP3 does: read, decoded, and shown or heard.
          </p>
          <p>
            Every file you drop stays in your browser. Play198x decodes it there and never uploads,
            stores, or transmits it.
          </p>
        </section>

        <section class="prose" aria-labelledby="what-it-plays-heading">
          <h2 id="what-it-plays-heading">What it plays today</h2>
          <p>
            Play198x reads five formats: ZX Spectrum SCREEN$, Commodore 64 Koala Paint, Commodore 64
            Art Studio, Amiga IFF ILBM, and ProTracker MOD.
          </p>
          <p>
            It does not yet play SID or AY chiptunes. Both need chip emulation that lives in Emu198x,
            and Emu198x's chip crates are not published yet
            (<a href="https://github.com/emu198x/emu198x/issues/1214">emu198x/emu198x#1214</a>).
          </p>
          <p>
            It opens plain files, ZIP archives, and Amiga ADF disk images (the standard density; not
            the high-density format), and decompresses PowerPacker-compressed entries on the way in.
            A ZIP of supported files opens, and an ADF opens. A ZIP of ADFs — the shape most TOSEC
            Amiga sets use — opens too, but the disk image inside it is listed as unrecognised. This
            player reads a disk image you drop on it, not one nested inside an archive.
          </p>
        </section>
      </div>
    </div>
  </section>

  <section class="band band-quiet">
    <div class="container">
      <section class="prose" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading">Downloads</h2>
        <p>There is no desktop application to download yet.</p>
        <p>
          The code behind this page is published for developers to build on: <a
            href="https://crates.io/crates/play198x-core">play198x-core</a> on crates.io is the Rust
          engine that decodes and plays this material, and <a
            href="https://www.npmjs.com/package/@play198x/web">@play198x/web</a> on npm is the
          WebAssembly build running this page. Neither ships a standalone application.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  /* The hero carries the tinted ground; the bands below alternate off it, so
     the page reads as sections without a rule drawn under each one. */
  .hero {
    background: var(--h-ground);
    border-bottom: 1px solid var(--h-line);
    padding-bottom: var(--h-space-12);
  }

  /* The one place a size is not read straight from the scale. --h-text-display
     is 4rem, which is right at container width and wider than a phone at
     375px. The clamp runs between two rungs of the same ladder — h1 and
     display — so it never lands outside the scale, only between its ends. */
  .hero-title {
    font-size: clamp(var(--h-text-h1), 11vw, var(--h-text-display));
    line-height: var(--h-lh-display);
    letter-spacing: var(--h-tr-display);
  }

  .hero-lead {
    max-width: var(--h-measure);
    margin-top: var(--h-space-4);
    font-size: var(--h-text-lead);
    line-height: var(--h-lh-lead);
  }

  /* The drop target is the call to action, so it gets the room a button row
     would have taken. */
  .hero :global(.drop-target) {
    margin-top: var(--h-space-8);
  }

  /* Two columns where there is room for two measures side by side, one column
     below that. The floor is the text itself: a column narrower than the copy
     wants to be reads worse than a column that waited its turn. */
  .columns {
    display: grid;
    gap: var(--h-space-12);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 34ch), 1fr));
  }

  .columns h2 {
    font-size: var(--h-text-h3);
    line-height: var(--h-lh-h3);
    letter-spacing: var(--h-tr-h3);
    font-weight: var(--h-weight-minor);
  }
</style>
