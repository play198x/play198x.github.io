---
/**
 * Where a visitor hands the player a file.
 *
 * The file picker (the visible <input type="file">) is not a fallback for
 * dragging — it is the accessible path. A visitor who cannot drag a file
 * (keyboard, touch, screen reader) still reaches the same onFile() as one
 * who drops it; see src/scripts/player.ts. The a11y gate in Task 9 checks
 * this path, but that is not why it exists.
 *
 * Draws nothing and decodes nothing itself — it names what the file is and
 * where it goes. Task 5 draws a decoded picture; Task 8 plays a module.
 *
 * Task 6 adds the archive entry list below: a dropped ZIP or Amiga ADF disk
 * image that holds more than one entry is listed here rather than guessed
 * at, populated by src/scripts/player.ts's renderArchiveList(). Empty and
 * hidden until there's an archive to show.
 */
---

<div id="drop-target" class="drop-target">
  <p class="drop-target-prompt">Drop a file here</p>
  <div class="drop-target-picker">
    <label class="drop-target-label" for="file-picker">Or choose a file from your device</label>
    <input id="file-picker" class="drop-target-input" type="file" />
  </div>
  <!-- What it takes, at the point of taking it. The sections below say the
       same thing at length; a visitor holding a file wants it here, and the
       three groups are named apart because reading a picture, playing a tune
       and opening a container are three different claims.

       A list rather than a sentence: set as one run of prose in a centred box
       it broke after "Music:" and orphaned "ProTracker MOD" on the next line,
       and no amount of balancing fixes a break the text has no clean point
       for. Three rows always break where the meaning does. -->
  <dl class="drop-target-formats">
    <dt>Pictures</dt>
    <dd>SCREEN$ · Koala · Art Studio · ILBM</dd>
    <dt>Music</dt>
    <dd>ProTracker MOD</dd>
    <dt>Containers</dt>
    <dd>ZIP · Amiga ADF</dd>
  </dl>
  <p id="drop-target-status" class="drop-target-status" role="status" aria-live="polite"></p>
</div>

<ul id="archive-entries" class="archive-entries" hidden></ul>

<script>
  import { onFile } from '../scripts/player';

  const target = document.getElementById('drop-target');
  const picker = document.getElementById('file-picker');

  if (target instanceof HTMLElement && picker instanceof HTMLInputElement) {
    target.addEventListener('dragover', (event) => {
      event.preventDefault();
      target.classList.add('is-active');
    });

    target.addEventListener('dragleave', () => {
      target.classList.remove('is-active');
    });

    target.addEventListener('drop', (event) => {
      event.preventDefault();
      target.classList.remove('is-active');
      const files = event.dataTransfer?.files;
      const file = files?.[0];
      if (file) {
        // Only the first of several dropped files is ever opened — see
        // onFile()'s own doc. Passing the real count is what lets it say so
        // instead of silently discarding the rest with no acknowledgment.
        void onFile(file, files.length);
      }
    });

    picker.addEventListener('change', () => {
      // The picker has no `multiple` attribute, so this is always exactly
      // one file — passed through anyway so both callers go through the
      // same signature.
      const file = picker.files?.[0];
      if (file) {
        void onFile(file, picker.files?.length ?? 1);
      }
    });
  }
</script>

<style>
  /* `[hidden] { display: none !important }` lives once, globally, in
   * src/pages/index.astro — see that file's comment. `.archive-entries`
   * below sets `display: flex`, which would otherwise beat `hidden`,
   * leaving an empty list rendered before any archive is opened. */

  /* Shaped like the panel it turns into. Player.astro's .player-panel has the
   * same radius, ground and lift, so dropping a file swaps the contents of a
   * box rather than replacing one shape with a different one — the page used
   * to jump at the exact moment the visitor did the thing the site is for.
   * The dashed border is the one thing kept apart, because it is what says
   * "target" rather than "panel"; it goes solid on drag-over. */
  .drop-target {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--h-space-4);
    padding: clamp(var(--h-space-6), 4vw, var(--h-space-8));
    border: 2px dashed var(--h-line);
    border-radius: 8px;
    background: var(--h-ground);
    box-shadow: var(--h-lift-1);
    text-align: center;
    font-family: var(--h-font-ui);
    color: var(--h-ink-body);
    /* §6's one motion rule: the target rises fast when a file is over it
     * and decays slowly when it leaves, the way phosphor does. Both
     * durations are zeroed by the kit under prefers-reduced-motion. */
    transition:
      border-color var(--h-decay) var(--h-ease),
      background var(--h-decay) var(--h-ease),
      box-shadow var(--h-decay) var(--h-ease);
  }

  .drop-target.is-active {
    border-color: var(--h-accent);
    border-style: solid;
    background: var(--h-page);
    box-shadow: var(--h-lift-1);
    transition-duration: var(--h-rise);
  }

  .drop-target-prompt {
    margin: 0;
    font-size: var(--h-text-lead);
    line-height: var(--h-lh-lead);
    color: var(--h-ink);
  }

  .drop-target-picker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--h-space-2);
  }

  .drop-target-label {
    color: var(--h-ink-muted);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  /* A visible, native <input type="file"> rather than a hidden input behind
   * a styled trigger — it is keyboard- and screen-reader-operable by
   * default, and this task's whole point is that the picker is a first-class
   * path, not a fallback dressed up to look secondary. */
  /* The input stays native and visible — see the note above — but its button
   * is the one control on the page that was rendering in the browser's own
   * grey rather than the house's. ::file-selector-button styles that button
   * without touching the element's semantics, so the keyboard and
   * screen-reader path is exactly the one the browser ships. The muted colour
   * is for the "No file chosen" text the browser writes beside it, which is
   * the browser's to word and not worth shouting. */
  .drop-target-input {
    font-family: inherit;
    font-size: var(--h-text-small);
    color: var(--h-ink-muted);
  }

  .drop-target-input::file-selector-button {
    margin-right: var(--h-space-3);
    padding: var(--h-space-2) var(--h-space-6);
    border: 1px solid var(--h-line);
    border-radius: 6px;
    background: var(--h-page);
    color: var(--h-ink-body);
    font: inherit;
    cursor: pointer;
    transition:
      border-color var(--h-decay) var(--h-ease),
      box-shadow var(--h-decay) var(--h-ease);
  }

  .drop-target-input:hover::file-selector-button {
    border-color: var(--h-accent);
    box-shadow: var(--h-lift-1);
    transition-duration: var(--h-rise);
  }

  .drop-target-input:focus-visible::file-selector-button {
    border-color: var(--h-accent);
    box-shadow: var(--h-lift-1);
  }

  /* An inline grid so the block centres in the box while its own two columns
     stay left-aligned — the same auto/1fr shape .player-meta uses for the
     panel this box turns into. */
  .drop-target-formats {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    gap: var(--h-space-1) var(--h-space-4);
    margin: 0;
    text-align: left;
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: var(--h-lh-micro);
    color: var(--h-ink-muted);
  }

  .drop-target-formats dd {
    margin: 0;
  }

  .drop-target-input:focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 3px;
  }

  .drop-target-status {
    margin: 0;
    min-height: 1.2em;
    color: var(--h-ink-body);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .archive-entries {
    display: flex;
    flex-direction: column;
    gap: var(--h-space-2);
    margin: var(--h-space-4) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--h-font-ui);
  }

  .archive-entry {
    margin: 0;
  }

  .archive-entry-button {
    width: 100%;
    padding: var(--h-space-2) var(--h-space-3);
    border: 1px solid var(--h-line);
    border-radius: 6px;
    background: var(--h-ground);
    color: var(--h-ink-body);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .archive-entry-button:hover,
  .archive-entry-button:focus-visible {
    border-color: var(--h-accent);
    background: var(--h-page);
  }

  /* Greyed out, not hidden — a visitor who dropped a disk expecting a tune
   * needs to see the disk holds no tune, which reads differently from
   * seeing nothing. A real `disabled` attribute drives this (see
   * archiveEntryRow() in src/scripts/player.ts), not a class applied to a
   * plain <span> — native disabled semantics are what makes this row
   * announced as disabled and unreachable by keyboard, not just styled to
   * look that way. */
  .archive-entry-button:disabled {
    border-style: dashed;
    border-color: var(--h-line-soft);
    background: none;
    color: var(--h-ink-muted);
    cursor: default;
  }
</style>
