---
// Draws whatever picture player.ts decoded and shows what is known about
// it, and — since Task 8 — offers a Play control for whatever module it
// identified instead. This component owns no logic of its own — decoding,
// canvas drawing, metadata formatting, playback and both panels' wiring all
// live in src/scripts/player.ts (which defers everything about how audio
// actually plays to src/scripts/audio.ts), so they can be exercised without
// a DOM (see tests/decode-image.test.mjs). This file is markup plus the
// lines that wire each panel's controls to that logic.
//
// Both panels start hidden until player.ts has something to show for them:
// a file that decodes to neither a picture nor a module (unknown, or
// nothing dropped yet) leaves both untouched and out of the way. Exactly
// one is ever shown at a time — see hideAllPanels()/hidePlayer()/
// hideAudioPlayer() in player.ts.
---

<section id="player-panel" class="player-panel" hidden>
  <canvas id="player-canvas" class="player-canvas"></canvas>

  <div class="player-info">
    <dl id="player-meta" class="player-meta">
      <dt>Source</dt>
      <dd id="player-source"></dd>
      <dt>Format</dt>
      <dd id="player-format"></dd>
      <dt>Size</dt>
      <dd id="player-dimensions"></dd>
    </dl>

    <!-- A .scr always probes "probable" — there is no author here to declare
         the format, so a weak identification is said out loud rather than
         rendered as if it were certain. -->
    <p id="player-confidence-note" class="player-confidence-note" hidden></p>

    <div id="player-override-wrap" class="player-override-wrap" hidden>
      <label class="player-override-label" for="player-override">
        Not what you expected? Try another format:
      </label>
      <select id="player-override" class="player-override"></select>
    </div>

    <div
      id="player-palette"
      class="player-palette"
      role="img"
      aria-label="The picture's palette, in hardware colour order"
    ></div>
  </div>
</section>

<section id="audio-player-panel" class="player-panel" hidden>
  <div class="player-info">
    <dl class="player-meta">
      <dt>Name</dt>
      <dd id="audio-name"></dd>
      <dt>Format</dt>
      <dd id="audio-format"></dd>
      <dt>Length</dt>
      <dd id="audio-length"></dd>
    </dl>

    <!-- Starting an AudioContext has to happen inside this button's own
         click handler — see src/scripts/audio.ts's playModule() doc — so
         nothing plays until it's pressed, even though the module's name,
         format and length are already shown above. -->
    <button id="audio-play-button" type="button" class="audio-play-button">Play</button>

    <p id="audio-position" class="audio-position" role="status" aria-live="polite"></p>
    <p id="audio-status" class="audio-status" role="alert"></p>
  </div>
</section>

<script>
  import { wireFormatOverride, wireAudioPlayer } from '../scripts/player';

  wireFormatOverride();
  wireAudioPlayer();
</script>

<style>
  /* `hidden` must actually hide. The browser's own `[hidden] { display:
   * none }` rule lives in the user-agent stylesheet, and ANY normal-weight
   * author rule beats ANY user-agent rule regardless of selector
   * specificity — the origin is compared before specificity is. Both
   * `.player-panel` and `.player-override-wrap` below set `display: flex`,
   * so without this, setting `.hidden = true` on either left them visibly
   * on screen (confirmed live on the public site: an empty black canvas
   * showing before any file was ever dropped). `!important` is what
   * browsers' own resets use for this exact collision — nothing short of it
   * survives a future rule that sets `display` on a hidden element again. */
  [hidden] {
    display: none !important;
  }

  .player-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    padding: clamp(1rem, 4vw, 1.75rem);
    border: 1px solid var(--h-line);
    border-radius: 8px;
    background: var(--h-ground);
    font-family: var(--h-font-ui);
    color: var(--h-ink-body);
  }

  /* The buffer is sized in mode pixels by script (width/height); the CSS
   * size is sized from pixel_aspect_w/h by the same script. Mode pixels are
   * not display pixels — see src/scripts/player.ts's drawImage(). */
  .player-canvas {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000;
    border: 1px solid var(--h-line-soft);
  }

  .player-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 16rem;
    flex: 1 1 16rem;
  }

  .player-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    margin: 0;
  }

  .player-meta dt {
    color: var(--h-ink-muted);
    font-size: 0.85em;
  }

  .player-meta dd {
    margin: 0;
    font-family: var(--h-font-mono);
    font-size: 0.9em;
  }

  .player-confidence-note {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--h-accent);
    background: var(--h-surface-light);
    color: var(--h-ink-body);
    font-size: 0.85em;
  }

  .player-override-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .player-override-label {
    color: var(--h-ink-muted);
    font-size: 0.85em;
  }

  .player-override {
    font-family: inherit;
    font-size: 0.9em;
  }

  .player-palette {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  :global(.player-swatch) {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid var(--h-line-soft);
    border-radius: 2px;
  }

  .audio-play-button {
    align-self: flex-start;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--h-line);
    border-radius: 6px;
    background: var(--h-ground);
    color: var(--h-ink-body);
    font: inherit;
    cursor: pointer;
  }

  .audio-play-button:hover,
  .audio-play-button:focus-visible {
    border-color: var(--h-accent);
    background: var(--h-surface-light);
  }

  .audio-play-button:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .audio-position {
    margin: 0;
    font-family: var(--h-font-mono);
    font-size: 0.9em;
    color: var(--h-ink-muted);
    min-height: 1.2em;
  }

  .audio-status {
    margin: 0;
    font-size: 0.9em;
    color: var(--h-ink-body);
  }
</style>
