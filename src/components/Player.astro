---
// Draws whatever picture player.ts decoded and shows what is known about
// it, and — since Task 8 — offers a Play control for whatever module it
// identified instead. This component owns no logic of its own — decoding,
// canvas drawing, metadata formatting, playback and both panels' wiring all
// live in src/scripts/player.ts (which defers everything about how audio
// actually plays to src/scripts/audio.ts), so they can be exercised without
// a DOM (see tests/decode-image.test.mjs). This file is markup plus the
// lines that wire each panel's controls to that logic.
//
// Both panels start hidden until player.ts has something to show for them:
// a file that decodes to neither a picture nor a module (unknown, or
// nothing dropped yet) leaves both untouched and out of the way. Exactly
// one is ever shown at a time — see hideAllPanels()/hidePlayer()/
// hideAudioPlayer() in player.ts.
---

<section id="player-panel" class="player-panel" hidden>
  <canvas id="player-canvas" class="player-canvas"></canvas>

  <div class="player-info">
    <dl id="player-meta" class="player-meta">
      <dt>Source</dt>
      <dd id="player-source"></dd>
      <dt>Format</dt>
      <dd id="player-format"></dd>
      <dt>Size</dt>
      <dd id="player-dimensions"></dd>
    </dl>

    <!-- A .scr always probes "probable" — there is no author here to declare
         the format, so a weak identification is said out loud rather than
         rendered as if it were certain. -->
    <p id="player-confidence-note" class="player-confidence-note" hidden></p>

    <div id="player-override-wrap" class="player-override-wrap" hidden>
      <label class="player-override-label" for="player-override">
        Not what you expected? Try another format:
      </label>
      <select id="player-override" class="player-override"></select>
    </div>

    <div
      id="player-palette"
      class="player-palette"
      role="img"
      aria-label="The picture's palette, in hardware colour order"
    ></div>
  </div>
</section>

<section id="audio-player-panel" class="player-panel" hidden>
  <div class="player-info">
    <dl class="player-meta">
      <dt>Name</dt>
      <dd id="audio-name"></dd>
      <!-- Hidden rather than blank when the module carries no title, which is
           common: an empty row beside a filled label reads as a value that
           failed to load. Both halves toggle together, or the grid keeps a
           gap where the pair used to be. -->
      <dt id="audio-title-label" hidden>Title</dt>
      <dd id="audio-title" hidden></dd>
      <dt>Format</dt>
      <dd id="audio-format"></dd>
      <dt>Length</dt>
      <dd id="audio-length"></dd>
      <dt>Voices</dt>
      <dd id="audio-voices"></dd>
    </dl>

    <!-- Every one of the 31 slots, including the empty ones, because the
         empty ones are the interesting ones: authors wrote greetings,
         credits and whole paragraphs down the unused half of the sample list
         where a tracker's own display shows them. Listing only the slots a
         song plays would drop those messages silently. Closed by default —
         it is content, not a control, and most modules have little to say. -->
    <details id="audio-samples" class="audio-samples" hidden>
      <summary>Sample names</summary>
      <ol id="audio-sample-list" class="audio-sample-list"></ol>
    </details>

    <!-- Shown only for a file that carries more than one tune, which a .ay
         often does and a module never does. Each song is a separate entry
         point with its own starting register state, so choosing one starts
         a new player rather than seeking within this one — which is why
         changing this restarts playback rather than scrubbing. -->
    <div id="audio-song-wrap" class="audio-song-wrap" hidden>
      <label for="audio-song">Song</label>
      <select id="audio-song" class="audio-song"></select>
    </div>

    <!-- Starting an AudioContext has to happen inside this button's own
         click handler — see src/scripts/audio.ts's playModule() doc — so
         nothing plays until it's pressed, even though the module's name,
         format and length are already shown above. -->
    <button id="audio-play-button" type="button" class="audio-play-button">Play</button>

    <p id="audio-position" class="audio-position" role="status" aria-live="polite"></p>
    <p id="audio-status" class="audio-status" role="alert"></p>
  </div>
</section>

<script>
  import { wireFormatOverride, wireAudioPlayer } from '../scripts/player';

  wireFormatOverride();
  wireAudioPlayer();
</script>

<style>
  /* `[hidden] { display: none !important }` lives once, globally, in
   * src/pages/index.astro — both `.player-panel` and `.player-override-wrap`
   * below set `display: flex`, which would otherwise beat `hidden` on
   * either. See that file's comment for why this used to be copied into
   * every component that needed it and no longer is. */

  .player-panel {
    display: flex;
    flex-wrap: wrap;
    gap: var(--h-space-6);
    align-items: flex-start;
    margin-top: var(--h-space-6);
    padding: clamp(var(--h-space-4), 4vw, var(--h-space-8));
    border: 1px solid var(--h-line);
    border-radius: 8px;
    /* A card on the band, not a shape drawn on the same colour as it — see
       DropTarget.astro's .drop-target, which this panel is matched to and
       which carries the full reasoning. */
    background: var(--h-page);
    box-shadow: var(--h-lift-1);
    font-family: var(--h-font-ui);
    color: var(--h-ink-body);
  }

  /* The buffer is sized in mode pixels by script (width/height); the CSS
   * size is sized from pixel_aspect_w/h by the same script. Mode pixels are
   * not display pixels — see src/scripts/player.ts's drawImage(). */
  .player-canvas {
    display: block;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
    background: #000;
    border: 1px solid var(--h-line-soft);
  }

  .player-info {
    display: flex;
    flex-direction: column;
    gap: var(--h-space-3);
    min-width: 16rem;
    flex: 1 1 16rem;
  }

  .player-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--h-space-1) var(--h-space-3);
    margin: 0;
  }

  .player-meta dt {
    color: var(--h-ink-muted);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .player-meta dd {
    margin: 0;
    font-family: var(--h-font-mono);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .player-confidence-note {
    margin: 0;
    padding: var(--h-space-2) var(--h-space-3);
    border-left: 3px solid var(--h-accent);
    /* Inset within the card, so it takes the band's ground rather than the
       card's — the note has to sit apart from the panel it is inside. */
    background: var(--h-ground);
    color: var(--h-ink-body);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .player-override-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--h-space-2);
  }

  .player-override-label {
    color: var(--h-ink-muted);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .player-override {
    font-family: inherit;
    font-size: var(--h-text-small);
  }

  .player-palette {
    display: flex;
    flex-wrap: wrap;
    gap: var(--h-space-1);
  }

  :global(.player-swatch) {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid var(--h-line-soft);
    border-radius: 2px;
  }

  .audio-play-button {
    align-self: flex-start;
    padding: var(--h-space-2) var(--h-space-6);
    border: 1px solid var(--h-line);
    border-radius: 6px;
    background: var(--h-ground);
    color: var(--h-ink-body);
    font: inherit;
    cursor: pointer;
  }

  /* A wash of the house accent over the button's own ground, not a swap to
   * another surface token: with the panel on --h-page the button rests on
   * --h-ground, and every other ground in the set is now either the panel's
   * or the band's, so a swap would make a hovered button read as part of
   * whatever it borrowed the colour from. The rust is house colour, not
   * project colour, so §3 is untouched. 9% follows emu198x.github.io's
   * --accent-soft, which solved this on the same palette. */
  .audio-play-button:hover,
  .audio-play-button:focus-visible {
    border-color: var(--h-accent);
    background: color-mix(in oklab, var(--h-accent) 9%, var(--h-ground));
    box-shadow: var(--h-lift-1);
  }

  .audio-play-button:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .audio-samples {
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
  }

  .audio-samples summary {
    cursor: pointer;
    color: var(--h-ink-muted);
  }

  .audio-sample-list {
    /* Slot numbers are the point: a name's position in the list is what tells
       a reader where in the tracker's display it sat, and a message written
       down the empty half only makes sense in order. */
    margin: var(--h-space-2) 0 0;
    padding-left: var(--h-space-8);
    font-family: var(--h-font-mono);
    font-size: var(--h-text-micro);
    line-height: var(--h-lh-micro);
    color: var(--h-ink-body);
  }

  .audio-sample-list li::marker {
    color: var(--h-ink-muted);
  }

  /* An empty slot still takes a line: it is where the next line of a message
     would go, and collapsing it would close up the shape the author typed. */
  .audio-sample-list li:empty::after {
    content: '';
    display: inline-block;
    height: 1em;
  }

  .audio-position {
    margin: 0;
    font-family: var(--h-font-mono);
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
    color: var(--h-ink-muted);
    min-height: 1.2em;
  }

  .audio-status {
    margin: 0;
    font-size: var(--h-text-small);
    line-height: var(--h-lh-small);
    color: var(--h-ink-body);
  }
</style>
